OPENAI_API_KEY=replace_me
RAG_CHAT_MODEL=gpt-5.5
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Sent to the API as `dimensions` (text-embedding-3-* only): up to 1536 for small,
# up to 3072 for large. Above 2000 the column becomes halfvec. Changing it needs a re-index.
RAG_EMBEDDING_DIM=1536
RAG_EMBEDDING_BATCH_SIZE=100
DATABASE_URL=postgresql://rag:rag@localhost:5434/rag
RAG_TOP_K=5
RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATES=20
RAG_RRF_K=60
# Translate the question into the corpus's other language for keyword search (+1 LLM call)
RAG_QUERY_TRANSLATION=false
RAG_CORPUS_LANGUAGES=en,ka
# Defaults to RAG_CHAT_MODEL; a smaller model cuts the added latency
RAG_TRANSLATION_MODEL=
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
